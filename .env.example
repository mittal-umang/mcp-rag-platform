# which generation backend to use: anthropic | openai | vllm
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-latest

# provider keys (only the selected provider's key is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# vllm (Phase 2) - OpenAI-compatible endpoint
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# embeddings (local, open)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# retrieval: dense | hybrid (hybrid = dense + BM25 sparse, RRF-fused in Qdrant)
RETRIEVAL_MODE=hybrid
SPARSE_MODEL=Qdrant/bm25
HYBRID_PREFETCH=50

# optional cross-encoder reranker (heavier; off by default)
RERANK_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=30

# guardrail: minimum top-1 dense cosine to attempt an answer
MIN_SCORE=0.30
